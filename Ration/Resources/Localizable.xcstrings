          }
        }
      }
    },
    "warmUp.disclosure.on" : {
      "comment" : "Shown when a Claude account is connected and warm-up is on: a real message will be sent to start the 5-hour window. Quote the per-account toggle \"Auto-start 5h window\" exactly as translated in account settings.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warm-up is on: Ration will start your 5-hour window automatically. Turn it off per account under Auto-start 5h window in Settings."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le préchauffage est activé : Ration démarrera automatiquement votre fenêtre de 5 heures. Désactivez-le compte par compte avec « Démarrage auto de la fenêtre de 5 h » dans les Réglages."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Розігрів увімкнено: Ration автоматично запускатиме ваше 5-годинне вікно. Вимкнути його для кожного облікового запису окремо можна в Параметрах, пункт «Автозапуск 5-годинного вікна»."
          }
        }
      }
    },
