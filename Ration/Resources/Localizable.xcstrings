    "onboarding.welcome.noMiddleman.detail" : {
      "comment" : "Setup guide › first step, bullet text under 'No middleman'. SSO = single sign-on.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There's no Ration server, no telemetry, and no account to create. You sign in on the provider's own page — or your SSO provider's, if you use one — and the session stays in an isolated profile on this Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas de serveur Ration, pas de télémétrie, aucun compte à créer. Vous vous connectez sur la page du fournisseur — ou celle de votre fournisseur SSO, si vous en utilisez un — et la session reste dans un profil isolé sur ce Mac."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Немає ні сервера Ration, ні телеметрії, ні облікового запису, який треба створювати. Ви входите на сторінці самого постачальника (або вашого SSO-постачальника, якщо ви ним користуєтеся), а сеанс залишається в ізольованому профілі на цьому Mac."
          }
        }
      }
    },
    "onboarding.welcome.noMiddleman.title" : {
