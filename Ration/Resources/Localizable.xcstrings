    "warmUp.disclosure.off" : {
      "comment" : "Shown when a Claude account is connected while the global warm-up switch is off. General = the Settings pane.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warm-up is off in General: Ration won't start your 5-hour window automatically."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
