    "featureSwitch.summary.inUse" : {
      "comment" : "One-line explanation under the In-use detection feature switch. IN USE = the pill on the in-use account card; Focus = the popover layout.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marks the account you're working in: IN USE tags, menu-bar dots, Focus hero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Signale le compte sur lequel vous travaillez : étiquettes EN COURS, points dans la barre des menus, compte mis en avant dans Focus."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Позначає обліковий запис, з яким ви працюєте: мітки АКТИВНИЙ, крапки в рядку меню, головний блок у режимі «Фокус»."
          }
        }
      }
    },
    "featureSwitch.summary.resets" : {
      "comment" : "One-line explanation under the Resets feature switch.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shows usage-limit resets on cards and in account settings, and alerts about them."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche les réinitialisations de limite sur les cartes et dans les réglages du compte, et envoie des alertes à leur sujet."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показує скидання лімітів на картках і в параметрах облікового запису та надсилає про них сповіщення."
          }
        }
      }
    },
    "featureSwitch.summary.switchAdvice" : {
      "comment" : "One-line explanation under the Switch suggestions feature switch.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suggests which account to move to when the one you're on nears its limit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suggère le compte vers lequel passer quand celui que vous utilisez approche de sa limite."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Підказує, на який обліковий запис перейти, коли поточний наближається до ліміту."
          }
        }
      }
    },
    "featureSwitch.summary.warmUp" : {
