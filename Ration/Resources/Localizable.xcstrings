{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ plan" : {
      "comment" : "Add account › plan step label. %@ = provider (Claude, ChatGPT).",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ plan"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forfait %@"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тариф %@"
          }
        }
      }
    },
    "%lld paused — manage in Settings" : {
      "comment" : "Popover empty state when accounts exist but all are paused. %lld = number of paused accounts. “Settings” is Ration's Settings window.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld paused — manage in Settings"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld en pause — gérer dans les Réglages"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Призупинено: %lld — керувати в Параметрах"
          }
        }
      }
    },
    "A ring per account, next to the menu bar icon, filled by the window below; accounts currently in use get a green center dot. Hover for exact values. Cursor has no rate windows and never shows." : {
      "comment" : "Settings › General note under the menu bar rings toggle. Cursor is a brand.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A ring per account, next to the menu bar icon, filled by the window below; accounts currently in use get a green center dot. Hover for exact values. Cursor has no rate windows and never shows."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un anneau par compte, à côté de l’icône de la barre des menus, rempli selon la fenêtre ci-dessous ; les comptes en cours d’utilisation ont un point vert au centre. Survolez-les pour voir les valeurs exactes. Cursor n’a pas de fenêtre de limite et n’apparaît jamais."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "По кільцю на кожен обліковий запис біля значка в рядку меню, заповненому за вікном, вибраним нижче; активні облікові записи мають зелену крапку в центрі. Наведіть курсор, щоб побачити точні значення. Cursor не має вікон лімітів і ніколи не показується."
          }
        }
      }
    },
    "AUTO" : {
